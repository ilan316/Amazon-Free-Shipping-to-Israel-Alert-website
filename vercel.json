{
  "redirects": [
    {
      "source": "/blog/mishloach-hinam-amazon-israel.html",
      "destination": "/blog/eich-ladaat-mishloach-hinam-amazon-israel.html",
      "permanent": true
    },
    {
      "source": "/guide.html",
      "destination": "/web-guide.html",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "amzfreeil.com" }],
      "destination": "https://www.amzfreeil.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path+.(png|jpg|jpeg|webp|avif|gif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path+.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://*.vercel-insights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://m.media-amazon.com https://images-na.ssl-images-amazon.com https://www.facebook.com; connect-src 'self' https://app.amzfreeil.com https://*.vercel-insights.com https://www.facebook.com; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
